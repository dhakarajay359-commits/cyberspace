# ─── Backend ─────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:3000

# Set to "false" to use direct host shell instead of Docker (dev/Windows without Docker)
USE_DOCKER=true

# Docker sandbox image name (built by: docker build -f docker/Dockerfile.sandbox -t linux-terminal-sandbox .)
SANDBOX_IMAGE=linux-terminal-sandbox

# Resource limits per container
CONTAINER_MEMORY=256m
CONTAINER_CPUS=0.5

# Session idle timeout in milliseconds (default 30 min)
SESSION_TIMEOUT=1800000

# JWT secret (used for session signing)
JWT_SECRET=change_this_to_a_long_random_string

# ─── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
